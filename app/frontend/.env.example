# PipingBox — Environment variables example
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` (it is gitignored).
#
# Vite exposes only variables prefixed with VITE_ to the client.
# The Supabase anon key is PUBLIC by design — it is safe in client code
# as long as Row-Level Security (RLS) is enforced (DEC-07).
# See: brain/03-ENGINEERING/DEPLOYMENT.md and brain/00-FOUNDATION/CTO_MEMORY.md (DEC-36, TD-01).

# Supabase project URL (without trailing slash)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon public key (safe to expose client-side; protected by RLS)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# TD-02 (DEC-37): Primary admin email. Intermediate fix — moved from hardcoded
# literal to env var so it can be changed without a code change. The proper
# fix is to move admin identification to a DB table or JWT claim (DEC-37),
# which requires a Supabase migration. This env var is still client-visible
# (public by design — admin auth is enforced by profile.role in DB + RLS).
# PB-PHONE-VERIFICATION-001: enable phone OTP verification UI.
# Requires a real SMS provider (Twilio/Vonage) configured in the Edge Function env.
VITE_PHONE_VERIFICATION_ENABLED=false

# PB-OBSERVABILITY-001 (PIPINGBOX DAILY INTELLIGENCE): PostHog product analytics.
# PUBLIC project key only (phc_...) — safe client-side by design. NEVER put a
# personal/private API key here. When unset, the observability layer is a
# fail-open no-op. Session replay stays disabled in code until masking,
# route blocking, sampling and consent are approved (PO 2026-09-10, action 7).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# PB-OBSERVABILITY-001: app version / commit SHA attached to error incidents
# (set at build time by CI; enables error tracking per build SHA).
VITE_APP_VERSION=dev
