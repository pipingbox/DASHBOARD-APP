{
  "name": "pipingbox-app-infra",
  "private": true,
  "type": "module",
  "description": "Infra-only package.json for Cloudflare Workers deployment (wrangler). The actual app lives in app/frontend.",
  "scripts": {
    "build": "cd app/frontend && npm run build",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "route:guard": "node --experimental-strip-types scripts/route-contract-guard.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.49.1",
    "pdfjs-dist": "^4.2.67",
    "wrangler": "^4.125.0"
  }
}
